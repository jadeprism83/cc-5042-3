{
  "name": "pavilion-sdf-type",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pavilion tour text renderer: distributable font -> SDF glyph atlas -> GPU instanced text.",
  "scripts": {
    "fonts": "node tools/fetch-fonts.mjs",
    "atlas": "node tools/build-atlas.mjs",
    "report": "node tools/compare-report.mjs",
    "build": "npm run fonts && npm run atlas && npm run report",
    "serve": "node tools/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "playwright test",
    "check": "node tools/fetch-fonts.mjs --check && npm test"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "playwright": "^1.65.1"
  }
}
